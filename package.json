{
  "name": "anti-detect-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Personal fingerprint browser manager built on fingerprint-chromium",
  "main": "src/main/index.js",
  "scripts": {
    "build:ui": "vite build",
    "start": "vite build && electron .",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER=http://localhost:5173 electron .\"",
    "smoke": "node scripts/smoke.js",
    "dist": "bash scripts/fetch-kernel.sh && vite build && electron-builder --mac",
    "fetch-kernel": "bash scripts/fetch-kernel.sh",
    "verify-fp": "node scripts/verify-fingerprint.js",
    "audit": "node scripts/audit-fingerprint.js"
  },
  "dependencies": {
    "proxy-chain": "^2.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
